# ---------------------------------------------------------------------------
# MINDSET HOCKEY — environment
# Copy to .env.local. The app runs in DEMO MODE with seed data if the Supabase
# values are left blank, so you can walk every screen before wiring anything up.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (TEST MODE keys while verifying) ---
# The setup-fee prices MUST be created as One-time, never Recurring.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STANDARD_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_STANDARD_SETUP=
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_SETUP=

# ---------------------------------------------------------------------------
# AI SHOT ANALYSIS
#
# Included with BOTH the Standard and Premium plans.
#
# These are deliberately NOT NEXT_PUBLIC_ — they are read only by server code
# (lib/ai/analyzer.ts) and must never be bundled into browser JavaScript.
#
# With no key set, the feature still works end to end: video uploads and stores
# normally, and the analysis is routed to the coach review queue instead of
# being scored. It never fabricates results to fill the gap.
# ---------------------------------------------------------------------------

# Set ONE of these. Anthropic is used first if both are present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o

# --- AI cost controls (all optional; defaults shown) ---
# Set a limit to 0 to disable it entirely.
AI_ANALYSES_PER_DAY=5
AI_ANALYSES_PER_MONTH=40
AI_MAX_VIDEO_MB=200
AI_MAX_FRAMES=12
AI_MAX_FRAME_MB=3
AI_TIMEOUT_MS=90000
# Lifetime of signed video playback URLs, in seconds.
AI_SIGNED_URL_TTL=3600

# --- Mux (signed video playback, optional) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# --- Email ---
RESEND_API_KEY=
