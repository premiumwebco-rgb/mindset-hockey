# ---------------------------------------------------------------------------
# MINDSET HOCKEY — environment
#
# Copy to .env.local for local development. The app runs in DEMO MODE with seed
# data if the Supabase values are left blank, so you can walk every screen
# before wiring anything up.
#
# NEVER COMMIT .env.local. It is ignored via .gitignore. Only this .env.example
# file — which holds blank placeholders and no real values — belongs in git.
#
# ┌─────────────────────────┬──────────────────────────┬──────────────────────┐
# │                         │ DEVELOPMENT (.env.local) │ PRODUCTION (host)    │
# ├─────────────────────────┼──────────────────────────┼──────────────────────┤
# │ NEXT_PUBLIC_SITE_URL    │ http://localhost:3005    │ https://mindsethockey.com │
# │ Supabase project        │ same project is fine     │ same or a separate one    │
# │ STRIPE_SECRET_KEY       │ sk_test_… / rk_test_…    │ rk_live_… (restricted)    │
# │ STRIPE_WEBHOOK_SECRET   │ from `stripe listen`     │ from the live endpoint    │
# │ Stripe price IDs        │ TEST-mode price IDs      │ LIVE-mode price IDs       │
# └─────────────────────────┴──────────────────────────┴──────────────────────┘
#
# Test-mode and live-mode Stripe objects are completely separate. A test price
# ID will not work with a live key, and vice versa — you need both sets.
#
# On Vercel, mark every secret below as a SENSITIVE environment variable so the
# value is write-only and never appears in build logs or the dashboard UI.
# ---------------------------------------------------------------------------

# Must match the origin the app is actually served from. Stripe redirects the
# member back here after checkout, and the Supabase email-confirmation link is
# built from it — a wrong value strands people on a dead page.
#   dev:  http://localhost:3005   (must match the port `npm run dev` uses)
#   prod: https://mindsethockey.com
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# --- Supabase ---
# NEXT_PUBLIC_SUPABASE_URL is the bare Project URL from Settings → API:
#   https://<project-ref>.supabase.co
# NOT the Data/REST API URL. A trailing /rest/v1 makes every auth call fail
# with "Invalid path specified in request URL".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (TEST MODE keys while verifying) ---
# The setup-fee prices MUST be created as One-time, never Recurring. A recurring
# setup fee would bill a family $249 or $389 EVERY MONTH.
# /api/stripe/checkout now verifies this against Stripe before creating a
# session and returns 409 rather than building a dangerous checkout — but fix
# the price in the dashboard, do not rely on the guard.
#
# Expected shape:
#   STANDARD_MONTHLY  $100.00 USD  recurring, monthly
#   STANDARD_SETUP    $249.00 USD  one-time
#   PREMIUM_MONTHLY   $149.00 USD  recurring, monthly
#   PREMIUM_SETUP     $389.00 USD  one-time
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3005/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STANDARD_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_STANDARD_SETUP=
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_SETUP=
# One-time $0.50 price for a single additional AI Shot Analysis.
# MUST be One-time (not recurring), USD, exactly 50 cents — the purchase route
# verifies all three against Stripe before creating a session and refuses if
# they do not match.
NEXT_PUBLIC_STRIPE_PRICE_ANALYSIS_ADDON=

# ---------------------------------------------------------------------------
# AI SHOT ANALYSIS
#
# Included with BOTH the Standard and Premium plans.
#
# These are deliberately NOT NEXT_PUBLIC_ — they are read only by server code
# (lib/ai/analyzer.ts) and must never be bundled into browser JavaScript.
#
# With no key set, the feature still works end to end: video uploads and stores
# normally, and the analysis is routed to the coach review queue instead of
# being scored. It never fabricates results to fill the gap.
# ---------------------------------------------------------------------------

# Set ONE of these. Anthropic is used first if both are present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o

# --- AI safety & cost observability ---
#
# CUSTOMER ENTITLEMENT IS NOT SET HERE. Analyses per week per tier
# (Standard 10, Premium 20) live in AI_ANALYSIS_LIMITS in lib/plans.ts, so the
# allowance a member paid for cannot be changed by a stray env var. Paid add-ons
# ($0.50 each) are banked in the analysis_purchases ledger by the Stripe webhook.
#
# THERE IS NO GLOBAL ANALYSIS-COUNT LIMIT. An earlier AI_GLOBAL_WEEKLY_MAX=500
# mistook a ~$500/month provider BUDGET for a cap of 500 analyses. It has been
# removed. Setting it now does nothing.
#
# EMERGENCY CONTROL — the one switch that stops spend immediately.
# Set to false and no new provider calls happen; clips still upload and route
# to a coach for manual review.
AI_ENABLED=true

# COST OBSERVABILITY (optional).
# Token counts are always recorded from the provider response. To also record
# an estimated USD figure, copy the current rates from your provider's pricing
# page. Leave both unset and estimated_cost_usd stays NULL — "not known",
# never a misleading $0. Nothing is enforced from these; they are for
# monitoring your monthly bill.
#   USD per MILLION tokens
# AI_COST_PER_MTOK_INPUT=
# AI_COST_PER_MTOK_OUTPUT=
#
# Reference only — displayed for your own tracking, never enforced in code.
# AI_MONTHLY_BUDGET_USD=500
#
# Query your spend with the SQL in supabase/migrations/0005_ai_cost_tracking.sql

AI_MAX_VIDEO_MB=200
AI_MAX_FRAMES=12
AI_MAX_FRAME_MB=3
AI_TIMEOUT_MS=90000
# Lifetime of signed video playback URLs, in seconds.
AI_SIGNED_URL_TTL=3600

# --- Mux (signed video playback, optional) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# --- Email ---
RESEND_API_KEY=
